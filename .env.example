# Copy this file to `.env` (in the folder where you run swiss-grocery) and fill it in.
# `.env` is git-ignored: never commit real keys.

# --- Supabase (only needed for `swiss-grocery sync`) ---------------------------
# Project URL: Supabase dashboard -> Project Settings -> API.
SUPABASE_URL=https://vldmauetfbudueiukcfc.supabase.co
# Secret key (starts with `sb_secret_`) or the legacy `service_role` key.
# It bypasses Row Level Security, so keep it private.
SUPABASE_SECRET_KEY=

# --- Optional settings ----------------------------------------------------------
# Where the local database lives (default: your user data folder).
# SWISS_GROCERY_DB=/path/to/grocery.db
# Product language for names and descriptions: de, fr or it (default: de).
# SWISS_GROCERY_LANG=de
# The same for one store only, e.g. Migros in French (--lang still wins).
# SWISS_GROCERY_MIGROS_LANG=fr
# Custom User-Agent sent to the stores (default identifies this tool).
# SWISS_GROCERY_USER_AGENT=
# Migros price region (default: national). Example: gmz (Zürich), gmaa (Aare).
# SWISS_GROCERY_MIGROS_REGION=national
