{
  "name": "swiss-grocery",
  "version": "0.1.0",
  "description": "Migros, Coop, Denner, Aldi Suisse and Lidl Suisse in one normalized command-line tool and price database.",
  "type": "module",
  "bin": {
    "swiss-grocery": "dist/cli.js"
  },
  "files": [
    "dist",
    "supabase",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "LIVE=1 vitest run test/live",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "keywords": [
    "migros",
    "coop",
    "denner",
    "aldi",
    "lidl",
    "switzerland",
    "grocery",
    "prices",
    "cli",
    "crawler"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/othmanehousni/swiss-cli.git"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "robots-parser": "^3.0.1",
    "undici": "^7.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "~4.0.18"
  }
}
